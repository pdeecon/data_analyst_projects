-- CHANGE OVER TIME 

-- How has monthly patient visit volume changed?
WITH monthly_count AS (
SELECT
    DATE_FORMAT(visit_date, '%Y-%m-01') AS month,
    COUNT(visit_id) as count_per_month
FROM patient_visit_fact_table
GROUP BY DATE_FORMAT(visit_date, '%Y-%m-01')
ORDER BY DATE_FORMAT(visit_date, '%Y-%m-01')  
),
monthly_change AS (
	SELECT
		month,
        count_per_month,
        LAG(count_per_month) OVER (ORDER BY month) AS previous_month_count
	FROM monthly_count
)
SELECT 
	month,
	-- SUM(count_per_month) OVER () as total_visits,
    count_per_month,
    ROUND((count_per_month - previous_month_count) /
    NULLIF(previous_month_count , 0) * 100 ,2) AS mom_change_pct
FROM monthly_change ;


-- How has monthly healthcare revenue changed?
SELECT 
	DATE_FORMAT(billing_date, '%Y-%m-01') AS month,
    SUM(amount_paid) AS total_amount_paid
FROM revenue_payment_fact_table
GROUP BY DATE_FORMAT(billing_date, '%Y-%m-01')
ORDER BY DATE_FORMAT(billing_date, '%Y-%m-01')

-- How have diagnoses changed over time?
SELECT  
	DATE_FORMAT(av.visit_date, '%Y-%m-01') AS month,
    COUNT(DISTINCT vft.patient_id) as total_diagnosis_count
FROM patient_visit_fact_table AS vft
LEFT JOIN silver_appointment_visits AS av
ON vft.visit_id = av.visit_id
GROUP BY DATE_FORMAT(av.visit_date, '%Y-%m-01')
ORDER BY DATE_FORMAT(av.visit_date, '%Y-%m-01')


-- How has prescription activity changed?
SELECT 
	DATE_FORMAT(prescription_date, '%Y-%m-01') AS month,
    COUNT(prescription_id) as total_prescription_count
FROM medication_and_prescription_analytics
GROUP BY DATE_FORMAT(prescription_date, '%Y-%m-01')
ORDER BY DATE_FORMAT(prescription_date, '%Y-%m-01')

-- How have visit statuses changed over time?
SELECT 
	DATE_FORMAT(visit_date, '%Y-%m-01') AS month,
    COUNT(visit_id) as total_visit_count
FROM patient_visit_fact_table
GROUP BY DATE_FORMAT(visit_date, '%Y-%m-01')
ORDER BY DATE_FORMAT(visit_date, '%Y-%m-01')




-- CUMULATIVE HEALTHCARE REVENUE 


-- What is the cumulative billing revenue generated by the healthcare organization over time?
SELECT
month,
total_amount_paid,
SUM(total_amount_paid) OVER (ORDER BY month) as running_total_revenue
FROM
(
SELECT 
	DATE_FORMAT(billing_date, '%Y-%m-01') AS month,
    SUM(amount_paid) AS total_amount_paid
FROM revenue_payment_fact_table
GROUP BY DATE_FORMAT(billing_date, '%Y-%m-01')
ORDER BY DATE_FORMAT(billing_date, '%Y-%m-01')
) y

-- How much money has been collected cumulatively over time, 
-- and how does it compare with the total amount billed?
SELECT
month,
total_bill,
total_amount_paid,
SUM(total_amount_paid) OVER (ORDER BY month) AS running_total_amount_paid,
SUM(outstanding_amount) OVER (ORDER BY month) AS running_outstanding_amount
FROM
(
SELECT 
	DATE_FORMAT(billing_date, '%Y-%m-01') AS month,
	SUM(amount) AS total_bill,
    SUM(amount_paid) AS total_amount_paid,
    SUM(outstanding_amount) AS outstanding_amount
FROM revenue_payment_fact_table
GROUP BY DATE_FORMAT(billing_date, '%Y-%m-01')
ORDER BY DATE_FORMAT(billing_date, '%Y-%m-01')
) t

-- How many patient visits have accumulated throughout the analysis period?

SELECT
month,
total_visits,
SUM(total_visits) OVER (ORDER BY month) as running_total_revenue,
total_completed_visits,
total_cancelled_visits
FROM
(
SELECT 
	DATE_FORMAT(visit_date, '%Y-%m-01') AS month,
    COUNT(visit_id) AS total_visits ,
    SUM(CASE 
            WHEN visit_status = 'Completed' THEN 1
            ELSE 0 END ) AS total_completed_visits ,
	SUM(CASE 
            WHEN visit_status = 'Cancelled' THEN 1
            ELSE 0 END ) AS total_cancelled_visits
FROM patient_visit_fact_table
GROUP BY DATE_FORMAT(visit_date, '%Y-%m-01')
ORDER BY DATE_FORMAT(visit_date, '%Y-%m-01')
) y

-- How has the cumulative number of recorded diagnoses grown over time?
SELECT
month,
total_diagnosis,
SUM(total_diagnosis) OVER (ORDER BY month) as running_total_diagnosis
FROM
(
SELECT 
	DATE_FORMAT(visit_date, '%Y-%m-01') AS month,
	COUNT(visit_id) AS total_diagnosis
FROM patient_visit_fact_table
GROUP BY DATE_FORMAT(visit_date, '%Y-%m-01')
ORDER BY DATE_FORMAT(visit_date, '%Y-%m-01')
) t

-- How many prescriptions have been issued cumulatively over time, 
-- and how does prescription activity change across periods?
SELECT
	month,
	total_prescription,
	SUM(total_prescription) OVER (ORDER BY month) as running_total_diagnosis
FROM
(
SELECT 
	DATE_FORMAT(prescription_date, '%Y-%m-01') AS month,
    COUNT(prescription_id) AS total_prescription
FROM medication_and_prescription_analytics
GROUP BY DATE_FORMAT(prescription_date, '%Y-%m-01')
ORDER BY DATE_FORMAT(prescription_date, '%Y-%m-01')
) t


-- PERFORMANCE ANALYSIS

-- How does each physician compare in terms of patient visits, diagnoses, 
-- prescriptions, and generated billing?

WITH total_visits AS (
	SELECT 
		physician_id,
        COUNT(visit_id) AS total_visits,
        COUNT(DISTINCT patient_id) AS total_patients
	FROM silver_appointment_visits
    GROUP BY physician_id
    ORDER BY physician_id 
),
total_diagnoses AS (
	SELECT 
		physician_id,
        COUNT(medical_record) AS total_diagnoses
    FROM silver_medical_record_diagnosis
    GROUP BY physician_id
    ORDER BY physician_id
),

total_prescriptions AS (
	SELECT 
		physician_id,
        COUNT(prescription_id) AS total_prescriptions
    FROM silver_prescriptions
    GROUP BY physician_id
	ORDER BY physician_id
),

total_bill_amount AS (
SELECT 
	physician_id,
    SUM(amount) AS billing_amount
FROM 
(
SELECT 
	av.visit_id,
    av.patient_id,
    av.physician_id,
    bp.amount
FROM silver_appointment_visits AS av
LEFT JOIN silver_billing_payments AS bp
ON av.patient_id = bp.patient_id
) T
GROUP BY physician_id
ORDER BY physician_id
)

SELECT 
	p.physician_id,
    p.physician_name,
    tv.total_visits,
    tv.total_patients,
    td.total_diagnoses,
    tp.total_prescriptions,
	billing_amount
FROM silver_physicians AS p

LEFT JOIN total_visits AS tv
ON p.physician_id = tv.physician_id

LEFT JOIN total_diagnoses AS td
ON p.physician_id = td.physician_id 

LEFT JOIN total_prescriptions AS tp
ON p.physician_id = tp.physician_id

LEFT JOIN total_bill_amount AS ba
ON p.physician_id = ba.physician_id


-- How does patient activity and 
-- financial performance vary across healthcare departments?
WITH total AS (
	SELECT 
		department_id,
        COUNT(DISTINCT patient_id) AS total_patients,
        COUNT(DISTINCT physician_id) AS total_physicians,
        COUNT(DISTINCT nurse_id) AS total_nurses,
        SUM(CASE 
            WHEN visit_status = 'Completed' THEN 1
            ELSE 0 END ) AS total_completed_visits,
		COUNT(visit_status) AS total_visits
	FROM silver_appointment_visits
    GROUP BY department_id
    ORDER BY department_id 
),
total_billing_and_paid AS (
	SELECT 
        av.department_id,
        SUM(bp.amount) AS total_billing,
        SUM(bp.amount_paid) AS total_amount_paid
    FROM silver_billing_payments AS bp
    LEFT JOIN silver_appointment_visits AS av
    ON bp.visit_id = av.visit_id 
    GROUP BY av.department_id
)
	SELECT 
		v.deparment_id,
        v.department_name,
        t.total_visits,
        t.total_patients,
        t.total_physicians,
        t.total_nurses,
        bp.total_billing,
        bp.total_amount_paid,
        ROUND( 100.0 * t.total_completed_visits / NULLIF(t.total_visits, 0),2) AS visit_completion_rate
	FROM silver_departments AS v
    
    LEFT JOIN total AS t
    ON v.deparment_id = t.department_id
    
    LEFT JOIN total_billing_and_paid AS bp
    ON v.deparment_id = bp.department_id
    
    

    -- How is patient workload distributed across nurses and their assigned shifts?

WITH nurses_total_visit AS (
SELECT 
nurse_id,
COUNT(visit_id) AS total_visit,
SUM(CASE 
            WHEN visit_time >= '00:00:00' AND visit_time <= '05:00:59' THEN 1
            ELSE 0 END ) AS grave_shift,
SUM(CASE 
            WHEN visit_time >= '06:00:00' AND visit_time <= '11:59:00' THEN 1
            ELSE 0 END ) AS morning_shift,
SUM(CASE 
            WHEN visit_time >= '12:00:00' AND visit_time <= '17:59:00' THEN 1
            ELSE 0 END ) AS afternoon_shift,
SUM(CASE 
            WHEN visit_time >= '18:00:00' AND visit_time <= '23:59:00' THEN 1
            ELSE 0 END ) AS night_shift
FROM silver_appointment_visits
GROUP BY nurse_id 
ORDER BY nurse_id
)

SELECT 
	n.nurse_name,
    total_visit,
    grave_shift,
    morning_shift,
    afternoon_shift,
    night_shift
FROM nurses_total_visit AS tv
LEFT JOIN silver_nurses AS n
ON tv.nurse_id = n.nurse_id

-- How effectively are billed amounts being collected, and which payment 
-- statuses or methods have the highest outstanding balances?


WITH payment_method_summary AS (
SELECT 
	payment_method,
    COUNT(payment_method) AS total_count,
    SUM(amount) AS total_billed,
    SUM(amount_paid) AS amount_paid,
    SUM(outstanding_amount) AS total_balance,
    SUM(CASE 
            WHEN payment_status = 'Partial' THEN 1
            ELSE 0 END ) AS count_partial_payment,
	SUM(CASE 
            WHEN payment_status = 'Paid' THEN 1
            ELSE 0 END ) AS count_paid_payment,
	SUM(CASE 
            WHEN payment_status = 'Pending' THEN 1
            ELSE 0 END ) AS count_pending_payment,
	SUM(CASE 
            WHEN payment_status = 'Unpaid' THEN 1
            ELSE 0 END ) AS count_unpaid_payment,
	SUM(CASE 
            WHEN payment_status = 'CANCELLED' THEN 1
            ELSE 0 END ) AS count_cancelled_payment
FROM revenue_payment_fact_table
GROUP BY payment_method
ORDER BY total_balance DESC
)

SELECT 
	payment_method,
    total_count,
    total_billed,
    amount_paid,
    ROUND((amount_paid / total_billed) * 100, 2) AS paid_percentage,
    total_balance,
    count_partial_payment,
    count_paid_payment,
    count_pending_payment,
    count_unpaid_payment,
    count_cancelled_payment
FROM payment_method_summary

SELECT 
	payment_status,
    COUNT(*)
FROM revenue_payment_fact_table
GROUP BY payment_status


-- PART TO WHOLE ANALYSIS
-- What percentage of the organization's total billing revenue is contributed by each department?

SELECT 
	y.department_name,
	-- ROUND(SUM(total_amount) OVER (),2) as overall_amount,
    y.total_amount,
    ROUND((total_amount / ROUND(SUM(total_amount) OVER (),2))* 100,2) AS percentage_total
FROM 
(
SELECT
	t.department_name,
    SUM(t.amount) as total_amount
FROM 
(
SELECT 
    d.department_name,
    bp.amount
FROM silver_billing_payments AS bp
LEFT JOIN silver_appointment_visits AS av
ON bp.visit_id = av.visit_id 
LEFT JOIN silver_departments AS d
ON av.department_id = d.deparment_id
) t
WHERE t.department_name IS NOT NULL
GROUP BY t.department_name
) y
ORDER BY percentage_total DESC

-- What percentage of total patient visits is handled by each department?
WITH total_visits_dep AS (
SELECT
	department_id,
    COUNT(visit_id) as total
FROM silver_appointment_visits
GROUP BY department_id
)

SELECT 
	vd.department_id,
	d.department_name,
	-- ROUND(SUM(vd.total) OVER (),2) as overall_count,
	vd.total,
	ROUND((vd.total / ROUND(SUM(vd.total) OVER (),2))* 100,2) AS percentage_total
FROM total_visits_dep AS vd
LEFT JOIN silver_departments AS d
ON vd.department_id = d.deparment_id
ORDER BY percentage_total DESC


-- Which charge types contribute the largest percentage of total healthcare billing?
WITH total AS (
SELECT 
	charge_type,
    SUM(amount) AS total_amount,
	SUM(amount_paid) AS total_amount_paid
FROM silver_billing_payments
GROUP BY charge_type
)

SELECT 
charge_type,
total_amount,
total_amount_paid,
-- ROUND(SUM(total_amount_paid) OVER (),2) as overall_amount_paid,
ROUND((total_amount_paid / ROUND(SUM(total_amount_paid) OVER (),2))* 100,2) AS percentage_total_paid
FROM total
ORDER BY percentage_total_paid DESC


-- What proportion of all recorded diagnoses belongs to each severity category?
WITH total_severity AS (
SELECT  
	severity,
    COUNT(medical_record) AS total_count
FROM silver_medical_record_diagnosis
GROUP BY severity
)

SELECT 
	severity,
    total_count,
	-- ROUND(SUM(total_count) OVER (),2) as overall_count,
    ROUND((total_count / ROUND(SUM(total_count) OVER (),2))* 100,2) AS percentage_total
FROM total_severity
ORDER BY percentage_total DESC

-- Which medications account for the largest share of total prescriptions?

WITH prescription_count AS (
SELECT 
    m.medication_name,
    COUNT(p.prescription_id) as total_prescription
FROM silver_prescriptions AS p
LEFT JOIN silver_medications m
ON p.medication_id = m.medication_id
GROUP BY m.medication_name
)
SELECT
	medication_name,
    total_prescription,
    -- ROUND(SUM(total_prescription) OVER (),2) as overall_count,
    ROUND((total_prescription / ROUND(SUM(total_prescription) OVER (),2))* 100,2) AS percentage_total
FROM prescription_count
ORDER BY percentage_total DESC



-- DATA SEGMENTATION

-- How are patients distributed across different age groups, 
-- and how does healthcare utilization vary between those groups?
SELECT 
	age_group,
    COUNT(age_group) as total_count
FROM
(
SELECT 
	patient_id,
    patient_name,
	CASE 
		WHEN age >= 0 AND age <= 17 THEN 'Pediatric'
        WHEN age > 17 AND age <= 29 THEN 'Young Adult'
        WHEN age > 29 AND age <= 44 THEN 'Adult'
        WHEN age > 44 AND age <= 59 THEN 'Middle Age'
        WHEN age > 59 AND age <= 74 THEN 'Senior'
		WHEN age > 75 THEN 'Elderly'
	ELSE 'Unknown' END AS age_group
 FROM patient_360_dimension
) t
GROUP BY age_group	

-- How can patients be segmented according to how frequently they 
-- visit the healthcare organization?

SELECT 
	patient_segments,
    COUNT(patient_segments) as total_count
FROM
(
SELECT
	patient_id,
    total_visit,
	CASE
		WHEN total_visit = 1 THEN  'One Time'
        WHEN total_visit >= 2 AND total_visit < 4 THEN   'Occasional'
        WHEN total_visit >= 4 AND total_visit < 7 THEN  'Regular'
        WHEN total_visit >= 7 THEN  'Frequent'
	ELSE 'Unknown' END AS patient_segments
FROM
(
SELECT 
	patient_id ,
    COUNT(visit_id) AS total_visit
FROM patient_visit_fact_table
GROUP BY patient_id
) t
) y
GROUP BY patient_segments

-- How can patients be segmented based on their total healthcare spending?
SELECT
	spend_segments,
    COUNT(spend_segments) AS total_count
FROM
(
SELECT 
	patient_id,
    total_amount,
    CASE 
		WHEN total_amount < 10000 THEN 'Low'
        WHEN total_amount >= 10000 AND total_amount < 50000 THEN 'Medium'
        WHEN total_amount >= 50000 AND total_amount < 100000 THEN 'High'
        WHEN total_amount >= 100000 THEN 'Very High'
	ELSE 'Unknown' END AS spend_segments
FROM
(
SELECT 
	patient_id,
    SUM(amount) AS total_amount
FROM revenue_payment_fact_table
GROUP BY patient_id
) t
) y
GROUP BY spend_segments

-- How can physicians be segmented according to the number of patient visits they handle?
SELECT
	work_load_segments,
    COUNT(work_load_segments) AS total_count
FROM
(
SELECT
	physician_id,
    total_visit,
    CASE 
		WHEN total_visit > 0 AND total_visit <= 50 THEN 'Low'
        WHEN total_visit > 50 AND total_visit <= 75 THEN 'Medium'
        WHEN total_visit > 75 AND total_visit <= 100 THEN 'High'
        WHEN total_visit > 100 THEN 'Very High'
	ELSE 'Unknown' END AS work_load_segments
FROM
(
SELECT 
	physician_id,
    COUNT(visit_id) as total_visit
FROM patient_visit_fact_table
GROUP BY physician_id
) t
) y
GROUP BY work_load_segments


-- During which parts of the day does the healthcare organization
--  experience the highest patient traffic?

SELECT 
	time_segments,
    COUNT(time_segments) AS total_count
FROM 
(
SELECT 
	visit_time,
    CASE
		WHEN visit_time >= '00:00:00' AND visit_time <= '05:59:00' THEN 'Night'
        WHEN visit_time >= '06:00:00' AND visit_time <= '11:59:00' THEN 'Morning'
        WHEN visit_time >= '12:00:00' AND visit_time <= '17:59:00' THEN 'Afternoon'
        WHEN visit_time >= '18:00:00' AND visit_time <= '23:59:00' THEN 'Evening'
	ELSE 'Unknown' END AS time_segments
FROM patient_visit_fact_table
) t
GROUP BY time_segments

